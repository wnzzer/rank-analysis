# /etc/claude-relay.env（chmod 600），systemd EnvironmentFile 读取
ANTHROPIC_API_KEY=sk-ant-...
PORT=8787
# 只听本机，公网经 Caddy HTTPS :8443 进来
BIND=127.0.0.1
# 与客户端编译期 CLAUDE_RELAY_TOKEN 一致；留空不校验（IP 调试阶段）
RELAY_TOKEN=
# 客户端 UA 前缀，非此前缀一律 403（置空关闭）
REQUIRED_UA_PREFIX=rank-analysis/
# Anthropic 未提供服务的地区，对照 https://www.anthropic.com/supported-countries 维护
BLOCKED_COUNTRIES=CN,HK,MO,RU,BY,IR,KP,SY,CU
# 测试白名单：逗号分隔，仅豁免地区限制；设备 ID 可从客户端「关于」页复制
# 设备 ID 是本地匿名标识，可被复制，不替代 RELAY_TOKEN 鉴权
ALLOWED_IPS=
ALLOWED_DEVICE_IDS=
ALLOWED_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
EFFORT=low
# 1 仅对白名单设备/IP 开启 Opus 5.5 Fast（更高费率），0 全部关闭；普通用户始终标准模式
FAST_MODE=0
MAX_TOKENS=8000
PER_IP_HOURLY=30
DAILY_CAP=500
# 1 时 /v1/region?ip=x.x.x.x 可指定 IP 调试
RELAY_DEBUG=1
